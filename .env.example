# =============================================================================
# Complio — Environment Configuration Template
# Copy to backend/.env and fill in values before starting the backend.
# =============================================================================

# ── Required: LLM ─────────────────────────────────────────────────────────────
LLM_API_KEY=sk-ant-api03-...         # Anthropic API key — pipeline is fully blocked without this
LLM_MODEL=claude-sonnet-4-6          # Model ID
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4

# ── Required: Database (Supabase / PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # ⚠ Never expose to clients — bypasses RLS

# ── Required in production: Security ─────────────────────────────────────────
ADMIN_API_KEY=...                    # Random secret for /api/admin/* endpoints
DOCUMENT_ENCRYPTION_KEY=...          # Fernet key — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
                                     # If unset, ephemeral key generated per process (dev only)

# ── Required in production: ChromaDB server mode ─────────────────────────────
CHROMA_SERVER_URL=http://chroma:8001 # Leave empty for embedded mode (dev/single-instance)
CHROMA_PERSIST_DIR=./backend/data/chroma_db  # Only used in embedded mode

# ── Required in production: Deployment ───────────────────────────────────────
ENVIRONMENT=production               # Set to "production" to enable hard startup checks
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Optional: Redis + Celery (leave empty for asyncio dev fallback) ───────────
REDIS_URL=redis://localhost:6379/0   # Enable Celery workers when set
CELERY_CONCURRENCY=2

# ── Optional: Billing (Stripe) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ENABLED=false                 # Set to true when Stripe is fully configured

# ── Optional: Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=re_...
CONTACT_EMAIL=hello@yourdomain.com

# ── Optional: Observability ───────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...  # Leave empty to disable Sentry

# ── Optional: Embedding models ────────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_FALLBACK=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ── Optional: Performance tuning ─────────────────────────────────────────────
PDF_CONCURRENCY=3                    # Max concurrent Playwright PDF renders
MAX_CONCURRENT_JOBS=5                # Max concurrent analysis jobs
JOB_TTL_SECONDS=3600                 # In-memory job TTL
DOCUMENT_TTL_SECONDS=604800          # Uploaded document vault TTL (7 days)
DOCUMENT_STORE_DIR=./backend/data/documents

# ── Optional: API server ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false                     # Set true only in dev
